# Environment variable examples for PutridParrot.Distributed.Demo
# Copy this file to .env and customize as needed

# Redis Connection
ConnectionStrings__Redis=localhost:6379

# SQL Server Connection
ConnectionStrings__SqlServer=Server=localhost,1433;Database=distributed;User Id=sa;Password=YourStrong@Password123;TrustServerCertificate=True;

# PostgreSQL Connection
ConnectionStrings__PostgreSQL=Host=localhost;Port=5432;Database=distributed;Username=postgres;Password=YourStrong@Password123;

# .NET Environment
DOTNET_ENVIRONMENT=Development
